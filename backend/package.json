{
  "name": "@takarabako/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Takarabako backend/orchestrator \u2014 PRD \u00a77.3. Treasury signer, deposit/verify/withdraw API, kiosk-facing endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "services": "node scripts/dev-services.mjs",
    "positions:audit": "tsx --env-file=.env scripts/positions-audit.ts",
    "chain:check": "tsx --env-file=.env scripts/chain-check.ts",
    "aqua:smoke": "tsx --env-file=.env scripts/aqua-smoke.ts",
    "mb:setup": "tsx --env-file=.env scripts/multibaas-setup.ts",
    "kiosk:register": "tsx --env-file=.env scripts/kiosk-register.ts",
    "bridge:smoke": "tsx --env-file=.env scripts/bridge-smoke.ts",
    "arc:e2e": "tsx scripts/arc-local-e2e.ts",
    "bridge:e2e": "tsx scripts/bridge-local-e2e.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "hedera:e2e": "E2E_CHAIN=hedera-testnet tsx scripts/arc-local-e2e.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "^0.3.4",
    "@1inch/swap-vm-sdk": "^0.4.4",
    "@anthropic-ai/sdk": "^0.125.0",
    "@curvegrid/multibaas-sdk": "^1.1.1",
    "@privy-io/node": "^0.34.0",
    "bullmq": "^6.3.9",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.30.0",
    "viem": "^2.56.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
