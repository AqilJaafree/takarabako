# Copy to .env — never commit the real file (see repo .gitignore).

PORT=4000

# Testnet RPC + treasury signer (Phase 1 — PRD §10: lives only here, never on the Pi)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TREASURY_PRIVATE_KEY=

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
USDC_ADDRESS=
VAULT_ADDRESS=

# Privy (PRD §7.8, revised) — replaces World ID Selfie Check. Email in,
# real embedded wallet + a stable user id out, no phone/QR/bridge needed.
# From your app's dashboard at dashboard.privy.io.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ENS v2 (PRD §7.7)
ENS_PARENT_NAME=wantest.eth

# Agentic yield (PRD §7.9)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001

WITHDRAW_FEE_BPS=200

# USD per 1 MYR for bill-acceptor deposits. Leave unset to use the live
# rate from open.er-api.com (cached 1h); set it to pin the rate for a demo.
# MYR_USD_RATE=0.2449

# Postgres (backend/docker-compose.yml)
DATABASE_URL=postgres://takarabako:takarabako@localhost:5432/takarabako
# Resend: API key + a sender on your verified domain. Unset = QR shown on the kiosk instead of emailed.
RESEND_API_KEY=
RESEND_FROM=Takarabako <takarabako@yourdomain>
# Redis (docker-compose.yml, or npm run services without Docker)
REDIS_URL=redis://localhost:6379

# QR email via Gmail (no domain needed): 2-Step Verification on, then an App Password
# from myaccount.google.com/apppasswords. Takes priority over Resend when set.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Curvegrid MultiBaas (multibaas.ts). Create a Sepolia deployment at
# console.curvegrid.com, then an admin API key under Admin → API Keys.
# Unset = the backend works without it (no dashboard aggregates or webhooks).
MULTIBAAS_URL=https://<deployment-id>.multibaas.com
MULTIBAAS_API_KEY=
# Printed by `npm run mb:setup` when it creates the webhook.
MULTIBAAS_WEBHOOK_SECRET=
# Public URL MultiBaas can reach for webhooks (e.g. a cloudflared tunnel to :4000).
PUBLIC_BACKEND_URL=

# tkCASH (contracts/script/DeployCashReceipt.s.sol) and this kiosk's id in it.
CASH_RECEIPT_ADDRESS=
KIOSK_ID=kl-sentral-01

# Treasury ops agent (opsAgent.ts). OPS_ADMIN_TOKEN approves its proposals —
# use a long random string.
OPS_AGENT_MODEL=claude-sonnet-5
OPS_ADMIN_TOKEN=
