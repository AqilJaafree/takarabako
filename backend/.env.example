# Copy to .env — never commit the real file (see repo .gitignore).

PORT=4000

# Which network the backend runs on: sepolia (default) | arc-testnet | arc.
# Switching it also means switching RPC_URL, USDC_ADDRESS, VAULT_ADDRESS (and
# METH_ADDRESS) to that chain's; blank values fall back to the chain's defaults.
#   arc-testnet  chain 5042002, RPC https://rpc.testnet.arc.io, USDC 0x3600…0000 (6 decimals),
#                gas is paid in USDC, sends need maxFeePerGas >= 20 gwei (applied automatically).
#                1inch Aqua is NOT deployed there: yield stays off unless you deploy it
#                and set AQUA_ADDRESS + AQUA_ROUTER_ADDRESS.
#   arc          chain 5042 (mainnet): Aqua is deployed (addresses come from the 1inch SDK);
#                set USDC_ADDRESS and METH_ADDRESS yourself.
# Check a setup without sending anything:  CHAIN=arc-testnet npm run chain:check
CHAIN=sepolia

# Testnet RPC + treasury signer (Phase 1 — PRD §10: lives only here, never on the Pi)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TREASURY_PRIVATE_KEY=

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
USDC_ADDRESS=
VAULT_ADDRESS=


# ---- Chains ----------------------------------------------------------------
# Takarabako runs on every chain in ENABLED_CHAINS at once. Each has its own vault,
# tkCASH and USDC; one treasury key signs on all of them. CHAIN (above) is the
# primary chain: where 1inch Aqua yield runs, where MultiBaas is connected, and
# where the unprefixed RPC_URL / USDC_ADDRESS / VAULT_ADDRESS / CASH_RECEIPT_ADDRESS apply.
# Per-chain values use a prefix and win over the unprefixed ones.
ENABLED_CHAINS=sepolia,arc-testnet
# Ethereum Sepolia: the vault must use Circle's Sepolia USDC (0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238)
# or CCTP can't bridge it. Get test USDC from https://faucet.circle.com.
# SEPOLIA_RPC_URL=
# SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# SEPOLIA_VAULT_ADDRESS=
# SEPOLIA_CASH_RECEIPT_ADDRESS=
# Arc Testnet (chain 5042002): gas is paid in USDC, the treasury needs USDC from the faucet.
# Its USDC defaults to 0x3600…0000. Deploy with contracts/script/DeployCashChain.s.sol.
# ARC_TESTNET_RPC_URL=
# ARC_TESTNET_VAULT_ADDRESS=
# ARC_TESTNET_CASH_RECEIPT_ADDRESS=
# Block the contracts were deployed at: the event log starts there. Unset = the last 5,000 blocks.
# ARC_TESTNET_INDEX_FROM_BLOCK=
# Hedera Testnet (chain 296, EVM side through the JSON-RPC relay): gas is HBAR and USDC is the Hedera Token
# Service token 0.0.429274 through its ERC-20 facade (the default below). Add hedera-testnet to ENABLED_CHAINS.
# Deploy with HEDERA=1 contracts/script/DeployCashChain.s.sol. No CCTP route to or from Hedera.
# HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
# HEDERA_TESTNET_USDC_ADDRESS=0x0000000000000000000000000000000000068cda
# HEDERA_TESTNET_VAULT_ADDRESS=
# HEDERA_TESTNET_CASH_RECEIPT_ADDRESS=
# HEDERA_TESTNET_INDEX_FROM_BLOCK=
# CCTP bridge between the chains (bridge.ts). Per-transfer cap in USD, and Circle's attestation service.
# BRIDGE_MAX_USD=1000
# CCTP_ATTESTATION_URL=https://iris-api-sandbox.circle.com

# Privy — email in,
# real embedded wallet + a stable user id out, no phone/QR/bridge needed.
# From your app's dashboard at dashboard.privy.io.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Agentic yield (PRD §7.9)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001

WITHDRAW_FEE_BPS=200

# USD per 1 MYR for bill-acceptor deposits. Leave unset to use the live
# rate from open.er-api.com (cached 1h); set it to pin the rate for a demo.
# MYR_USD_RATE=0.2449

# Postgres (backend/docker-compose.yml)
DATABASE_URL=postgres://takarabako:takarabako@localhost:5432/takarabako
# Resend: API key + a sender on your verified domain. Unset = QR shown on the kiosk instead of emailed.
RESEND_API_KEY=
RESEND_FROM=Takarabako <takarabako@yourdomain>
# Redis (docker-compose.yml, or npm run services without Docker)
REDIS_URL=redis://localhost:6379

# QR email via Gmail (no domain needed): 2-Step Verification on, then an App Password
# from myaccount.google.com/apppasswords. Takes priority over Resend when set.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Curvegrid MultiBaas (multibaas.ts). Create a Sepolia deployment at
# console.curvegrid.com, then an admin API key under Admin → API Keys.
# Unset = the backend works without it (no dashboard aggregates or webhooks).
MULTIBAAS_URL=https://<deployment-id>.multibaas.com
MULTIBAAS_API_KEY=
# Printed by `npm run mb:setup` when it creates the webhook.
MULTIBAAS_WEBHOOK_SECRET=
# Public URL MultiBaas can reach for webhooks (e.g. a cloudflared tunnel to :4000).
PUBLIC_BACKEND_URL=

# tkCASH (contracts/script/DeployCashReceipt.s.sol) and this kiosk's id in it.
CASH_RECEIPT_ADDRESS=
KIOSK_ID=tokyo-01

# Treasury ops agent (opsAgent.ts). OPS_ADMIN_TOKEN approves its proposals —
# use a long random string.
OPS_AGENT_MODEL=claude-opus-5
OPS_ADMIN_TOKEN=

# 1inch Aqua yield (aqua.ts). Addresses default to the official SDK maps for the
# chain (on Sepolia: the shared registry and the earlier router below). Test the
# whole flow on Sepolia with:  npm run aqua:smoke -- --send
# AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
# AQUA_ROUTER_ADDRESS=0x1111113db0e0ef9d0e3a50d5f094a3a57a26c0de
# METH_ADDRESS=0x5A9E9fF59AeBb96C14DFaB7C2a43d0C130ba9282
# Self-custody positions on Arc mainnet: the customer signs with their own wallet
# (the wallet is the Aqua maker; no vault or treasury). Real money, so off unless
# SELF_CUSTODY_ARC=1. The cap is per position, in USD. ARC_RPC_URL overrides the
# public Arc RPC (use a paid one with a fallback for anything real).
# SELF_CUSTODY_ARC=1
# SELF_CUSTODY_MAX_USD=100
# ARC_RPC_URL=
# The same flow on Sepolia, to try it with worthless tokens first (only when CHAIN=sepolia).
# SELF_CUSTODY_SEPOLIA=1
# An AquaPositionManager (contracts/src/AquaPositionManager.sol) lets a position open and
# close in one transaction instead of one per strategy; the tokens sit in the contract while
# a position is open. Unset = the wallet itself is the Aqua maker. Deployed 2026-11-07:
# SELF_MANAGER_SEPOLIA=0x3864873b1d4353E08EC4a3a496871fAB244c6590
# SELF_MANAGER_ARC=0x6cc5f175810e61A56508049f0527BC75EB7e77e4
# More pairs (a base token against USDC, the quote token every position exits to) beyond a chain's first
# (Arc: WETH/USDC). Each is a real-money product of its own, so it is off unless named. "eurc" is Arc's
# EURC/USDC stable pair: narrow ranges, a 5 bps fee, priced from the Arc pool checked against the ECB
# rate. With no manager deployed for the pair (SELF_MANAGER_ARC_EURC) the wallet signs each strategy.
# SELF_EXTRA_PAIRS=eurc
# SELF_MANAGER_ARC_EURC=
# Dash out sells a customer's leftover base token for USDC through Aqua. It is refused when the best
# strategies pay more than this far below the market (percent), and each swap carries a minimum payout
# of its quote less the slippage allowance (basis points).
# DASH_OUT_MAX_DISCOUNT_PCT=3
# DASH_OUT_SLIPPAGE_BPS=50
# Demo market maker that trades against open strategies (1 = on).
AQUA_SIM=1
AQUA_SIM_INTERVAL_MS=600000

# The most any account can move per day, in USD (deposits, withdrawals, yield, sends,
# bridging). The tkCASH contract's own daily transfer limit should be set to the same figure.
DAILY_LIMIT_USD=1000
