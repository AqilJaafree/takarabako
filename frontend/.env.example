# Copy to .env.local and fill in.

# Privy app id (same app as backend/.env PRIVY_APP_ID). Add this site's
# origin (http://localhost:3000, later the deployed URL) to the Privy
# dashboard's allowed origins, and turn on email login.
NEXT_PUBLIC_PRIVY_APP_ID=

# The Express backend. Only the Next.js server calls it; browsers never do.
BACKEND_URL=http://localhost:4000

# The Pi's bill-acceptor bridge (device-agent/server.js). After a kiosk login
# the Next.js server hands it the session so stacked notes go to that
# account. Leave empty to run /kiosk without the box.
PI_BRIDGE_URL=http://10.42.0.225:8080

# Shared with the Pi bridge (~/.takarabako/bridge-secret on the Pi). Required
# when the bridge is reached through its Cloudflare tunnel (PI_BRIDGE_URL =
# https://….trycloudflare.com), and on the local network once the Pi has one.
BRIDGE_SECRET=

# 1 = show a "Test: insert RM10" button on /kiosk for bench testing.
KIOSK_TEST_DEPOSIT=0
